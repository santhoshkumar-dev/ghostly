{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "outDir": "./out",
    "declaration": true,
    "declarationMap": true,
    "target": "ESNext",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["electron-vite/node"]
  },
  "include": [
    "electron/**/*.ts",
    "electron.vite.config.ts",
    "src/lib/groqWhisper.ts",
    "src/lib/parakeetHost.ts",
    "src/lib/parakeetModelFacts.ts",
    "src/lib/systemMemory.ts",
    "src/lib/debugClipSave.ts",
    "src/lib/sessionContext.ts",
    "src/lib/conversationThread.ts"
  ]
}
